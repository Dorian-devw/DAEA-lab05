<UserControl x:Class="Mejora_NeptunoAPP.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="TruckSolid" Width="40" Height="40" Foreground="#1C1C1E"/>
                    <StackPanel Margin="15,0,0,0">
                        <TextBlock Text="Mantenimiento de Proveedores" FontSize="24" FontWeight="Bold" Foreground="#1C1C1E"/>
                        <TextBlock Text="Filtra y gestiona tus proveedores" FontSize="14" Foreground="#888888"/>
                    </StackPanel>
                </StackPanel>

                <!-- Filtros -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Buscar Contacto:" FontWeight="SemiBold"/>
                        <TextBox Width="120" Text="{Binding FiltroNombreContacto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Ciudad:" FontWeight="SemiBold"/>
                        <TextBox Width="100" Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Content="Buscar" Command="{Binding BuscarCommand}" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
             <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Compañía" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CompaniaNombre, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="Contacto" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                
                <StackPanel Grid.Column="2" Margin="10,0,10,0">
                    <TextBlock Text="Ciudad" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="10,0,10,0">
                    <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Style="{StaticResource ActionButtonStyle}" Background="#E53935"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
             <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="Eliminar" Command="{Binding EliminarCommand}" Style="{StaticResource ActionButtonStyle}" Background="#E53935"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="Transparent" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Compañía" Binding="{Binding CompaniaNombre}" Width="*"/>
                        <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="*"/>
                        <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="150"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
