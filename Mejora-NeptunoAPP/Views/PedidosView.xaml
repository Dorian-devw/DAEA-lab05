<UserControl x:Class="Mejora_NeptunoAPP.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
        </Style>
        
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#1C1C1E"/>
                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                    <Setter Property="BorderThickness" Value="0,0,0,3"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <iconPacks:PackIconFontAwesome Kind="ShoppingCartSolid" Width="40" Height="40" Foreground="#1C1C1E"/>
                <StackPanel Margin="15,0,0,0">
                    <TextBlock Text="Mantenimiento de Pedidos" FontSize="24" FontWeight="Bold" Foreground="#1C1C1E"/>
                    <TextBlock Text="Gestiona pedidos y visualiza reportes por fecha" FontSize="14" Foreground="#888888"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: CRUD -->
            <TabItem Header="Mantenimiento">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Formulario -->
                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Fecha Pedido" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding FechaPedido, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="Destinatario" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Destinatario, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,10,0">
                                <TextBlock Text="Ciudad Destino" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CiudadDestino, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                <Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                                <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Style="{StaticResource ActionButtonStyle}" Background="#E53935"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Lista -->
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Button Content="Eliminar" Command="{Binding EliminarCommand}" Style="{StaticResource ActionButtonStyle}" Background="#E53935"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Pedidos}" SelectedItem="{Binding PedidoSeleccionado}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      Background="Transparent" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="None">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding PedidoID}" Width="50"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat=d}" Width="100"/>
                                    <DataGridTextColumn Header="Destinatario" Binding="{Binding Destinatario}" Width="*"/>
                                    <DataGridTextColumn Header="Ciudad Destino" Binding="{Binding CiudadDestino}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Reporte -->
            <TabItem Header="Reporte de Detalles">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                         <Border.Effect>
                            <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filtro de Fechas:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker SelectedDate="{Binding FiltroFechaInicio}" Margin="0,0,10,0"/>
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker SelectedDate="{Binding FiltroFechaFin}" Margin="0,0,20,0"/>
                            <Button Content="Generar Reporte" Command="{Binding GenerarReporteCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">
                         <Border.Effect>
                            <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <DataGrid ItemsSource="{Binding ReporteDetalles}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  Background="Transparent" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha Pedido" Binding="{Binding FechaPedido, StringFormat=d}" Width="120"/>
                                <DataGridTextColumn Header="ID Pedido" Binding="{Binding PedidoID}" Width="80"/>
                                <DataGridTextColumn Header="ID Producto" Binding="{Binding ProductoID}" Width="100"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                                <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnidad, StringFormat=C}" Width="120"/>
                                <DataGridTextColumn Header="Descuento" Binding="{Binding Descuento, StringFormat=P}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
